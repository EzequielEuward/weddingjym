NODE_ENV=development
PORT=3000

# Seguridad (Cambiar obligatoriamente en producción)
COOKIE_SECRET=replace-with-at-least-32-random-characters-secret
QR_GATE_TOKEN=replace-with-unique-venue-qr-token
MODERATOR_PIN=123456

# Base de Datos
# - Desarrollo rápido sin Docker (PostgreSQL embebido PGlite): pglite://./data/pgdata
# - Arch Linux Docker o Supabase PostgreSQL: postgresql://postgres:postgres@localhost:5432/wedding
DATABASE_URL=pglite://./data/pgdata

# Almacenamiento de fotos: 'local' | 'supabase'
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/photos

# Solo requerido cuando STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=wedding-photos

# Opcional para docker-compose en Arch Linux
POSTGRES_USER=wedding
POSTGRES_PASSWORD=wedding_local_pass
POSTGRES_DB=wedding
CLOUDFLARE_TUNNEL_TOKEN=
